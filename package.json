    "db:seed": "npm run db:seed -w backend",
    "test": "npm test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
