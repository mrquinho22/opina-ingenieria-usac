{
  "name": "opina-ingenieria-usac",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB \"npm run dev -w backend\" \"npm start -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
